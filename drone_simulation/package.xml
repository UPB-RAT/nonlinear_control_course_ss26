<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_simulation</name>
  <version>0.0.0</version>
  <description>Drone simulation package using Gazebo and ROS 2 bridge</description>

  <maintainer email="ekansh@todo.todo">ekansh</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>actuator_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>